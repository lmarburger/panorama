#!/usr/bin/env bash
#
# Grafana API helper for the Panorama stack.
#
#   scripts/grafana list                    list dashboards (uid + title)
#   scripts/grafana get <uid> [outfile]     fetch a dashboard; writes JSON to stdout or outfile
#   scripts/grafana save <file> [--label L] save a dashboard back (overwrite: true)
#   scripts/grafana panels <uid>            print panel titles, types, and PromQL targets
#   scripts/grafana api <path> [curl args]  raw API call, e.g. api /api/health
#   scripts/grafana query '<promql>'        instant query through the Prometheus data source
#   scripts/grafana --cloud <command>       run list, get, panels, api, or query against Grafana Cloud
#   scripts/grafana sync-cloud [--dry-run]  mirror every local dashboard to Grafana Cloud
#
# sync-cloud treats local as the source of truth. It overwrites each cloud
# dashboard with the local copy, repoints Prometheus queries at the cloud
# stack's built-in data source, and deletes cloud dashboards it synced before
# that no longer exist locally. Needs GRAFANA_CLOUD_URL and
# GRAFANA_CLOUD_API_TOKEN (a service account token, Editor role) in .env.
#
# Override the endpoint or credentials with GRAFANA_URL / GRAFANA_AUTH.
#
# The embedded Python runs inside single-quoted shell strings, so it must not
# contain a single quote anywhere.
set -euo pipefail

# Pick up GRAFANA_ADMIN_PASSWORD from the gitignored .env so the credential lives
# in exactly one place and never has to be passed on the command line.
ENV_FILE="$(cd "$(dirname "$0")/.." && pwd)/.env"
if [ -f "$ENV_FILE" ]; then
  set -a; . "$ENV_FILE"; set +a
fi

GRAFANA_URL="${GRAFANA_URL:-http://localhost:4242}"
GRAFANA_AUTH="${GRAFANA_AUTH:-admin:${GRAFANA_ADMIN_PASSWORD:-panorama}}"
CLOUD=""

die() { printf 'grafana: %s\n' "$*" >&2; exit 1; }

if [ "${1:-}" = "--cloud" ]; then
  shift
  [ -n "${GRAFANA_CLOUD_URL:-}" ] || die "--cloud needs GRAFANA_CLOUD_URL in .env"
  [ -n "${GRAFANA_CLOUD_API_TOKEN:-}" ] || die "--cloud needs GRAFANA_CLOUD_API_TOKEN in .env"
  CLOUD=1
  case "${1:-}" in
    save|sync-cloud) die "$1 is local only: local Grafana is the source of truth (use sync-cloud)" ;;
  esac
fi

usage() { sed -n '2,/^set -euo/p' "$0" | sed 's/^# \{0,1\}//; $d'; }

api() {
  local path="$1"; shift
  if [ -n "$CLOUD" ]; then
    curl -sS --fail-with-body -H "Authorization: Bearer $GRAFANA_CLOUD_API_TOKEN" "${GRAFANA_CLOUD_URL%/}$path" "$@"
  else
    curl -sS --fail-with-body -u "$GRAFANA_AUTH" "$GRAFANA_URL$path" "$@"
  fi
}

# The Prometheus data source dashboards query: the stack's grafanacloud-*-prom
# in the cloud, the default Prometheus locally.
prom_ds_uid() {
  api /api/datasources | python3 -c '
import json, sys
ds = [d for d in json.load(sys.stdin) if d["type"] == "prometheus"]
cloud = [d for d in ds if d["name"].startswith("grafanacloud-") and d["name"].endswith("-prom")]
pick = cloud or [d for d in ds if d.get("isDefault")] or ds
if not pick:
    sys.exit("grafana: no Prometheus data source")
print(pick[0]["uid"])
'
}

cmd_query() {
  local q="${1:-}"
  [ -n "$q" ] || die "query requires a PromQL expression"
  local ds
  ds="$(prom_ds_uid)"
  python3 -c '
import json, sys
print(json.dumps({"queries": [{"refId": "A", "datasource": {"type": "prometheus", "uid": sys.argv[1]},
                               "expr": sys.argv[2], "instant": True}], "from": "now-5m", "to": "now"}))
' "$ds" "$q" \
    | api /api/ds/query -X POST -H 'Content-Type: application/json' --data-binary @- \
    | python3 -c '
import json, sys
r = json.load(sys.stdin)["results"]["A"]
if r.get("error"):
    sys.exit("error: " + r["error"])
frames = r.get("frames") or []
rows = 0
for f in frames:
    fields = f["schema"]["fields"]
    values = f["data"]["values"]
    for i, field in enumerate(fields):
        if field.get("type") == "time" or not values[i]:
            continue
        m = dict(field.get("labels") or {}); name = m.pop("__name__", "")
        labels = ",".join("{}={}".format(k, v) for k, v in sorted(m.items()))
        print("{:>24}  {}{{{}}}".format(values[i][-1], name, labels))
        rows += 1
if not rows:
    print("(empty result)")
'
}

cmd_list() {
  api "/api/search?type=dash-db" | python3 -c '
import json, sys
for d in json.load(sys.stdin):
    print(d["uid"] + "\t" + d["title"])
'
}

cmd_get() {
  local uid="${1:-}" out="${2:-}"
  [ -n "$uid" ] || die "get requires a dashboard uid (see: scripts/grafana list)"
  if [ -n "$out" ]; then
    api "/api/dashboards/uid/$uid" -o "$out"
    printf 'wrote %s\n' "$out"
  else
    api "/api/dashboards/uid/$uid"
  fi
}

# Accepts either a full GET response ({"dashboard": {...}, "meta": {...}}) or a
# bare dashboard object, so a file from `get` can be edited and fed straight back.
cmd_save() {
  local file="${1:-}"; shift || true
  local label=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --label) label="${2:-}"; shift 2 ;;
      *) die "unknown option: $1" ;;
    esac
  done
  [ -n "$file" ] || die "save requires a JSON file"
  [ -f "$file" ] || die "no such file: $file"

  local payload
  payload="$(LABEL="$label" python3 -c '
import json, os, sys
doc = json.load(open(sys.argv[1]))
dash = doc.get("dashboard", doc)
payload = {"dashboard": dash, "overwrite": True}
if os.environ.get("LABEL"):
    payload["message"] = os.environ["LABEL"]
folder = (doc.get("meta") or {}).get("folderUid")
if folder:
    payload["folderUid"] = folder
json.dump(payload, sys.stdout)
' "$file")"

  printf '%s' "$payload" \
    | api "/api/dashboards/db" -X POST -H 'Content-Type: application/json' --data-binary @- \
    | python3 -c '
import json, sys
r = json.load(sys.stdin)
uid, ver, url = r.get("uid"), r.get("version"), r.get("url")
print("saved {} version {} -> {}".format(uid, ver, url))
'
}

cmd_panels() {
  local uid="${1:-}"
  [ -n "$uid" ] || die "panels requires a dashboard uid"
  api "/api/dashboards/uid/$uid" | python3 -c '
import json, sys
db = json.load(sys.stdin)["dashboard"]
print("{}  (uid {}, version {})".format(db.get("title"), db.get("uid"), db.get("version")))

def walk(panels, indent=2):
    for p in panels:
        pad = " " * indent
        print(pad + "[{}] {}".format(p.get("type"), p.get("title")))
        for t in p.get("targets") or []:
            expr = t.get("expr")
            if expr:
                print(pad + "    expr: " + " ".join(expr.split()))
        if p.get("panels"):
            walk(p["panels"], indent + 4)

walk(db.get("panels") or [])
'
}

cmd_sync_cloud() {
  [ -n "${GRAFANA_CLOUD_URL:-}" ] || die "sync-cloud needs GRAFANA_CLOUD_URL in .env"
  [ -n "${GRAFANA_CLOUD_API_TOKEN:-}" ] || die "sync-cloud needs GRAFANA_CLOUD_API_TOKEN in .env"
  LOCAL_URL="$GRAFANA_URL" LOCAL_AUTH="$GRAFANA_AUTH" \
  CLOUD_URL="${GRAFANA_CLOUD_URL%/}" CLOUD_TOKEN="$GRAFANA_CLOUD_API_TOKEN" \
  python3 - "$@" <<'PY'
import base64, copy, json, os, sys, urllib.error, urllib.request

dry_run = "--dry-run" in sys.argv[1:]
# Marks the cloud dashboards this command owns. Grafana Cloud ships its own
# dashboards (IRM plugins drop some into General), and only tagged ones are
# ever deleted.
SYNC_TAG = "panorama-sync"
unknown = [a for a in sys.argv[1:] if a != "--dry-run"]
if unknown:
    sys.exit("grafana: unknown option: " + unknown[0])

local_auth = "Basic " + base64.b64encode(os.environ["LOCAL_AUTH"].encode()).decode()
cloud_auth = "Bearer " + os.environ["CLOUD_TOKEN"]


def call(base, auth, path, method="GET", body=None, missing_ok=False):
    req = urllib.request.Request(base + path, method=method, headers={
        "Authorization": auth, "Content-Type": "application/json", "Accept": "application/json"})
    if body is not None:
        req.data = json.dumps(body).encode()
    try:
        with urllib.request.urlopen(req, timeout=30) as r:
            raw = r.read()
    except urllib.error.HTTPError as e:
        if missing_ok and e.code == 404:
            return None
        sys.exit("grafana: {} {}{} -> HTTP {}: {}".format(method, base, path, e.code, e.read().decode()[:300]))
    return json.loads(raw) if raw else None


def local(path):
    return call(os.environ["LOCAL_URL"], local_auth, path)


# Look things up by uid rather than through /api/folders or /api/search: on
# Grafana Cloud those lists lag a few seconds behind writes.
def cloud(path, method="GET", body=None, missing_ok=False):
    return call(os.environ["CLOUD_URL"], cloud_auth, path, method, body, missing_ok)


local_ds = {d["uid"] for d in local("/api/datasources") if d["type"] == "prometheus"}
# Every Grafana Cloud stack provisions its own metrics data source as
# grafanacloud-<stack>-prom, next to other Prometheus-typed ones (usage, ML),
# so match on the name.
cloud_ds = [d for d in cloud("/api/datasources")
            if d["type"] == "prometheus" and d["name"].startswith("grafanacloud-") and d["name"].endswith("-prom")]
if len(cloud_ds) != 1:
    sys.exit("grafana: expected one grafanacloud-*-prom data source, found: {}".format([d["name"] for d in cloud_ds]))
target = {"type": "prometheus", "uid": cloud_ds[0]["uid"]}


def repoint(node):
    if isinstance(node, dict):
        for k, v in node.items():
            if k == "datasource":
                if isinstance(v, dict) and (v.get("uid") in local_ds or v.get("type") == "prometheus"):
                    node[k] = dict(target)
                elif isinstance(v, str) and v not in ("-- Grafana --", "-- Mixed --", "-- Dashboard --"):
                    node[k] = dict(target)
                else:
                    repoint(v)
            else:
                repoint(v)
    elif isinstance(node, list):
        for v in node:
            repoint(v)


def comparable(dash):
    d = copy.deepcopy(dash)
    for k in ("id", "version"):
        d.pop(k, None)
    return d


local_folders = {f["uid"]: f["title"] for f in local("/api/folders")}
for uid, title in sorted(local_folders.items()):
    existing = cloud("/api/folders/" + uid, missing_ok=True)
    if not existing:
        print("create folder  {}".format(title))
        if not dry_run:
            cloud("/api/folders", "POST", {"uid": uid, "title": title})
    elif existing["title"] != title:
        print("rename folder  {} -> {}".format(existing["title"], title))
        if not dry_run:
            cloud("/api/folders/" + uid, "PUT", {"title": title, "overwrite": True})

local_uids = set()
for hit in local("/api/search?type=dash-db&limit=5000"):
    doc = local("/api/dashboards/uid/" + hit["uid"])
    dash, folder = doc["dashboard"], doc["meta"].get("folderUid", "")
    local_uids.add(dash["uid"])
    repoint(dash)
    dash["tags"] = sorted(set(dash.get("tags") or []) | {SYNC_TAG})
    remote = cloud("/api/dashboards/uid/" + dash["uid"], missing_ok=True)
    if remote and comparable(remote["dashboard"]) == comparable(dash) and remote["meta"].get("folderUid", "") == folder:
        print("unchanged      {}".format(dash["title"]))
        continue
    print("{}  {} (local v{})".format("update        " if remote else "create        ", dash["title"], dash.get("version")))
    if not dry_run:
        dash.pop("id", None)
        cloud("/api/dashboards/db", "POST", {
            "dashboard": dash, "folderUid": folder, "overwrite": True,
            "message": "synced from local v{}".format(dash.get("version"))})

for hit in cloud("/api/search?type=dash-db&limit=5000&tag=" + SYNC_TAG):
    if hit["uid"] in local_uids:
        continue
    print("delete         {} (not in local)".format(hit["title"]))
    if not dry_run:
        cloud("/api/dashboards/uid/" + hit["uid"], "DELETE")

if dry_run:
    print("dry run: nothing changed")
PY
}

cmd_api() {
  local path="${1:-}"; shift || true
  [ -n "$path" ] || die "api requires a path, e.g. /api/health"
  api "$path" "$@"
  echo
}

case "${1:-}" in
  list)   shift; cmd_list "$@" ;;
  get)    shift; cmd_get "$@" ;;
  save)   shift; cmd_save "$@" ;;
  panels) shift; cmd_panels "$@" ;;
  api)    shift; cmd_api "$@" ;;
  query)  shift; cmd_query "$@" ;;
  sync-cloud) shift; cmd_sync_cloud "$@" ;;
  ""|-h|--help|help) usage ;;
  *) die "unknown command: $1 (try --help)" ;;
esac
